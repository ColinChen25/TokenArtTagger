<Window x:Class="TokenArtTagger.App.AiReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review AI suggestions" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        Background="#F4F3EF" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Closing="Window_Closing" Closed="Window_Closed" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ReadOnlyText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Margin="12,0,0,0" />
            <StackPanel>
                <TextBlock Text="Review AI suggestions" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Choose the tags you trust. Unresolved fields can wait for later." Margin="0,5,0,0" Foreground="#555555" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button Content="Refresh queue" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                    <CheckBox Content="Show reviewed proposals" IsChecked="{Binding IncludeReviewed}" IsEnabled="{Binding CanNavigate}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Proposals}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                         AutomationProperties.Name="AI proposals" IsEnabled="{Binding CanNavigate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="7,9" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="{Binding Suggestion.ImagePath}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="#E8E5DF" BorderBrush="#D7D3CA" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="Verified image preview" />
                </Border>
                <TextBox Grid.Row="1" Text="{Binding Selected.Suggestion.ImagePath, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"
                         Margin="0,10,0,0" Foreground="#555555" />
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#D7D3CA" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Field decisions" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ImportNotice}" Foreground="#555555" Margin="0,6,0,12" />
                        <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding Editable}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <WrapPanel Margin="0,3,0,5">
                                            <TextBlock Text="Current: " Foreground="#555555" />
                                            <TextBlock Text="{Binding Current}" Margin="0,0,16,0" />
                                            <TextBlock Text="AI: " Foreground="#555555" />
                                            <TextBlock Text="{Binding Suggested}" />
                                        </WrapPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                                                  Padding="5" MinHeight="32" AutomationProperties.Name="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ValidationMessage}" Margin="0,2,0,10" />
                        <CheckBox IsChecked="{Binding ReplaceConfirmed}" IsEnabled="{Binding Editable}" Margin="0,0,0,12"
                                  Visibility="{Binding NeedsReplaceConfirmation, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="Replace existing tags with the choices shown above" />
                        </CheckBox>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Save reviewed tags" Command="{Binding SaveCommand}" />
                            <Button Content="Dismiss proposal" Command="{Binding DismissCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ReviewHistory}" Foreground="#245C37" Margin="0,0,0,10" />
                        <Expander Header="Model and evidence" IsExpanded="True">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox Text="{Binding Provenance, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Foreground="#555555" />
                                <TextBox Text="{Binding Evidence, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,8,0,0" />
                                <TextBlock Text="Model output is a suggestion, not measured confidence." Foreground="#555555" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Message}" Margin="0,14,0,0" AutomationProperties.Name="Review status" />
    </Grid>
</Window>
